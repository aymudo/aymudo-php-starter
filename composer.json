{
  "name": "aymudo/aymudo-php-starter",
  "description": "Capability-driven PHP 8.2+ starter dashboard for Aymudo.",
  "type": "project",
  "license": "MIT",
  "repositories": [{ "type": "vcs", "url": "https://github.com/aymudo/aymudo-php-sdk" }],
  "require": { "php": "^8.2", "aymudo/aymudo-php-sdk": "dev-main" },
  "autoload": { "psr-4": { "AymudoStarter\\": "src/" } },
  "scripts": { "serve": "php -S 127.0.0.1:8080 -t public", "test": "php tests/smoke.php" },
  "config": { "sort-packages": true, "allow-plugins": {} },
  "minimum-stability": "dev",
  "prefer-stable": true
}
